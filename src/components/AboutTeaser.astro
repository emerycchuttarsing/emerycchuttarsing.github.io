---
import { site } from '../data/site';
---

<section class="about-teaser" aria-labelledby="about-title">
  <div class="about-teaser-inner wrap">
    <p class="eyebrow">02 / A little context</p>
    <div>
      <h2 id="about-title">
        Curiosity is the starting point.
        <br />
        <em>Rigor is the method.</em>
      </h2>
      <div class="about-teaser-details">
        <p>{site.shortBiography}</p>
        <a class="text-link" href="/about/">
          More about me <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </div>
</section>
