---
import type { Project } from '../lib/projects';
interface Props {
  steps: Project['data']['workflow'];
}
const { steps } = Astro.props;
---

<section class="method-diagram" aria-labelledby="method-overview">
  <p class="eyebrow">The working process</p>
  <h2 id="method-overview">Method at a glance</h2>
  <ol>
    {steps.map((step, index) => (
      <li>
        <span class="step-number" aria-hidden="true">
          {String(index + 1).padStart(2, '0')}
        </span>
        <h3>{step.title}</h3>
        <p>{step.description}</p>
      </li>
    ))}
  </ol>
</section>
<style>
  .method-diagram {
    margin-bottom: 3.5rem;
  }
  .method-diagram > .eyebrow {
    margin-bottom: 0.6rem;
  }
  .method-diagram h2 {
    font-size: 2.2rem;
    margin: 0 0 1.8rem;
    scroll-margin-top: 2rem;
  }
  .method-diagram ol {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .method-diagram li {
    position: relative;
    padding: 1.4rem 1.25rem 1rem;
    background: #e8e5db;
    border-top: 1px solid #9eacaa;
    min-width: 0;
  }
  .method-diagram li + li {
    border-left: 1px solid var(--color-paper);
  }
  .method-diagram li:not(:last-child)::after {
    content: '→';
    position: absolute;
    z-index: 1;
    right: -0.6rem;
    top: 1.15rem;
    width: 1.2rem;
    text-align: center;
    font-family: var(--font-label);
    color: var(--color-accent);
    background: #e8e5db;
  }
  .step-number {
    font: 0.65rem var(--font-label);
    color: var(--color-accent);
  }
  .method-diagram h3 {
    font-size: 1.35rem;
    line-height: 1.2;
    margin: 1.1rem 0 0.8rem;
    text-wrap: wrap;
  }
  .method-diagram li p {
    font-size: 0.8rem;
    line-height: 1.7;
    color: var(--color-muted);
    margin: 0;
  }
  @media (max-width: 700px) {
    .method-diagram ol {
      grid-template-columns: 1fr;
    }
    .method-diagram li {
      padding: 1.3rem;
    }
    .method-diagram li + li {
      border-left: 0;
      border-top: 1px solid var(--color-line);
    }
    .method-diagram li:not(:last-child)::after {
      content: '↓';
      right: 1.2rem;
      top: auto;
      bottom: -0.75rem;
    }
    .method-diagram h3 {
      margin-top: 0.6rem;
    }
  }
</style>
