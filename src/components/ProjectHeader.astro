---
import type { Project } from '../lib/projects';
interface Props {
  project: Project;
}
const { project } = Astro.props;
const {
  title,
  summary,
  order,
  categories,
  context,
  role,
  technologies,
  contributions,
} = project.data;
---

<header class="page-heading project-header">
  <p class="eyebrow">
    Study {String(order).padStart(2, '0')} / {categories.join(' / ')}
  </p>
  <h1>{title}</h1>
  <p class="lead">{summary}</p>
  <div class="project-details">
    <dl class="project-facts">
      <div>
        <dt class="eyebrow">Context</dt>
        <dd>{context}</dd>
      </div>
      <div>
        <dt class="eyebrow">My role</dt>
        <dd>{role}</dd>
      </div>
      <div>
        <dt class="eyebrow">Toolbox</dt>
        <dd class="project-tags">{technologies.join(' · ')}</dd>
      </div>
    </dl>
    <section class="contribution-summary" aria-labelledby="contributions-title">
      <h2 id="contributions-title" class="eyebrow">
        My contributions
      </h2>
      <ul>
        {contributions.map((contribution, index) => (
          <li>
            <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            {contribution}
          </li>
        ))}
      </ul>
    </section>
  </div>
</header>
<style>
  .project-header h1 {
    max-width: 22ch;
    font-size: clamp(2.8rem, 5.6vw, 5.6rem);
  }
  .project-header .lead {
    max-width: 57ch;
  }
  .project-details {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: 4rem;
    margin-top: 3rem;
    border-top: 1px solid var(--color-line);
    padding-top: 1.75rem;
  }
  .project-facts {
    margin: 0;
    display: grid;
    gap: 1.25rem;
  }
  .project-facts dt {
    margin-bottom: 0.3rem;
  }
  .project-facts dd {
    margin: 0;
    font-size: 0.85rem;
    color: var(--color-muted);
  }
  .project-facts dd.project-tags {
    font-size: 0.7rem;
  }
  .contribution-summary h2 {
    font: 0.64rem/1.6 var(--font-label);
    margin: 0 0 0.5rem;
    letter-spacing: 0.12em;
    text-wrap: wrap;
  }
  .contribution-summary ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .contribution-summary li {
    display: grid;
    grid-template-columns: 1.5rem 1fr;
    gap: 0.8rem;
    font-size: 0.85rem;
    padding-block: 0.7rem;
    border-bottom: 1px solid #cec8ba80;
  }
  .contribution-summary li span {
    color: var(--color-accent);
    font: 0.6rem/1.8 var(--font-label);
    padding-top: 0.15rem;
  }
  @media (max-width: 700px) {
    .project-details {
      grid-template-columns: 1fr;
      gap: 2rem;
      margin-top: 2rem;
    }
    .project-header h1 {
      font-size: clamp(2.5rem, 9.5vw, 4rem);
      overflow-wrap: anywhere;
    }
  }
</style>
