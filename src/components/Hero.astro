---
import { site } from '../data/site';
---

<section class="hero" aria-labelledby="intro-title" data-hero>
  <div class="hero-copy wrap">
    <p class="eyebrow hero-label">
      <span class="status-dot" aria-hidden="true"></span>
      {site.headline}
    </p>
    <h1 id="intro-title">
      Emeryc
      <br />
      <em>Chuttarsing</em>
      <span class="title-period">.</span>
    </h1>
    <div class="hero-introduction">
      <p>
        Finding structure
        <br />
        in a world of uncertainty.
      </p>
      <p class="hero-description">
        I build models and systems at the intersection of finance, mathematics
        and machine learning.
      </p>
      <a class="text-link" href="#projects">
        Explore my work <span aria-hidden="true">↘</span>
      </a>
    </div>
  </div>
  <div class="terrain-fallback" aria-hidden="true"></div>
  <div class="landscape-label wrap" aria-hidden="true">
    <p class="eyebrow">
      A landscape of possibilities
      <br />
      <span>f(x, y) · sampled in space</span>
    </p>
    <span class="landscape-cross">+</span>
  </div>
  <div class="hero-bottom wrap">
    <p class="eyebrow">Mathematical thinking. Applied.</p>
    <a href="#projects" class="eyebrow">
      Selected projects <span aria-hidden="true">↓</span>
    </a>
  </div>
</section>
