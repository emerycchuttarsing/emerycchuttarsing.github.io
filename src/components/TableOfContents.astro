---
interface Props {
  headings: { depth: number; slug: string; text: string }[];
}
const { headings } = Astro.props;
const entries = [
  { slug: 'method-overview', text: 'Method at a glance' },
  ...headings.filter(({ depth }) => depth === 2),
];
---

<nav class="table-of-contents" aria-label="On this page">
  <p class="eyebrow">In this study</p>
  <ol>
    {entries.map(({ slug, text }, index) => (
      <li>
        <a href={`#${slug}`}>
          <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          {text}
        </a>
      </li>
    ))}
  </ol>
</nav>
<style>
  .table-of-contents {
    position: sticky;
    top: 2rem;
  }
  .table-of-contents .eyebrow {
    margin-bottom: 1.1rem;
  }
  .table-of-contents ol {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--color-line);
  }
  .table-of-contents li {
    border-bottom: 1px solid #cec8ba70;
  }
  .table-of-contents a {
    display: grid;
    grid-template-columns: 1.25rem 1fr;
    gap: 0.5rem;
    padding-block: 0.7rem;
    font-size: 0.75rem;
    line-height: 1.6;
    text-decoration: none;
  }
  .table-of-contents a span {
    color: var(--color-accent);
    font: 0.55rem/2.2 var(--font-label);
  }
  .table-of-contents a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  @media (max-width: 900px) {
    .table-of-contents {
      position: static;
      margin-bottom: 1rem;
    }
    .table-of-contents ol {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 2rem;
    }
  }
  @media (max-width: 500px) {
    .table-of-contents ol {
      grid-template-columns: 1fr;
    }
  }
</style>
