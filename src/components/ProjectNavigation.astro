---
import { projectPath, type Project } from '../lib/projects';
interface Props {
  previous: Project | undefined;
  next: Project | undefined;
}
const { previous, next } = Astro.props;
---

<nav class="project-navigation" aria-label="Study navigation">
  <div class="adjacent-projects">
    {previous && (
      <a
        class="adjacent-project previous-project"
        href={projectPath(previous.id)}
        rel="prev"
      >
        <span class="eyebrow">← Previous study</span>
        <span class="adjacent-title">{previous.data.title}</span>
      </a>
    )}
    {next && (
      <a
        class="adjacent-project next-project"
        href={projectPath(next.id)}
        rel="next"
      >
        <span class="eyebrow">Next study →</span>
        <span class="adjacent-title">{next.data.title}</span>
      </a>
    )}
  </div>
  <div class="collection-links">
    <a class="text-link" href="/projects/">
      All projects <span aria-hidden="true">↗</span>
    </a>
    <a class="text-link" href="/#projects">
      Back to the gallery <span aria-hidden="true">↗</span>
    </a>
  </div>
</nav>
<style>
  .project-navigation {
    margin-top: 5rem;
    border-top: 1px solid var(--color-line);
  }
  .adjacent-projects {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 3rem;
  }
  .adjacent-project {
    display: block;
    text-decoration: none;
    padding-block: 2rem;
  }
  .adjacent-project > span {
    display: block;
  }
  .next-project {
    grid-column: 2;
  }
  .adjacent-title {
    font: 1.65rem/1.3 var(--font-display);
    letter-spacing: -0.02em;
    margin-top: 0.9rem;
    max-width: 29ch;
  }
  .collection-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    border-top: 1px solid var(--color-line);
    padding-top: 1rem;
  }
  @media (max-width: 700px) {
    .adjacent-projects {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .next-project {
      grid-column: 1;
    }
    .adjacent-project {
      padding-block: 1.5rem;
    }
    .adjacent-project + .adjacent-project {
      border-top: 1px solid #cec8ba70;
    }
    .adjacent-title {
      font-size: 1.4rem;
    }
  }
</style>
