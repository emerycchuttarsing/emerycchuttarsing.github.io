---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ProjectsShowcase from '../components/ProjectsShowcase.astro';
import AboutTeaser from '../components/AboutTeaser.astro';
import PortfolioScene from '../components/PortfolioScene.astro';
import ProjectPreview from '../components/ProjectPreview.astro';
import { site } from '../data/site';
import { getProjects, toSceneProject } from '../lib/projects';
import '../styles/home.css';
const projects = await getProjects();
---

<BaseLayout title={site.headline} home>
  <PortfolioScene projects={projects.map(toSceneProject)} />
  <Hero />
  <div class="scene-transition" aria-hidden="true"></div>
  <ProjectsShowcase projects={projects} />
  <AboutTeaser />
  <ProjectPreview />
</BaseLayout>
