---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ProjectGallery from '../components/ProjectGallery.astro';
import AboutTeaser from '../components/AboutTeaser.astro';
import PortfolioScene from '../components/PortfolioScene.astro';
import ProjectPreview from '../components/ProjectPreview.astro';
import { site } from '../data/site';
import { getProjects, toSceneProject } from '../lib/projects';
import '../styles/home.css';
const projects = await getProjects();
---

<BaseLayout title={site.headline} home>
  <PortfolioScene projects={projects.map(toSceneProject)} />
  <Hero />
  <div class="atmosphere" aria-hidden="true">
    <span>From possibilities to practice</span>
  </div>
  <ProjectGallery projects={projects} />
  <AboutTeaser />
  <ProjectPreview />
</BaseLayout>
