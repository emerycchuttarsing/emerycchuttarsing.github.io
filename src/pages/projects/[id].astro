---
import { render } from 'astro:content';
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectHeader from '../../components/ProjectHeader.astro';
import ProjectFigure from '../../components/ProjectFigure.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import MethodDiagram from '../../components/MethodDiagram.astro';
import Prose from '../../components/Prose.astro';
import ProjectResources from '../../components/ProjectResources.astro';
import ProjectNavigation from '../../components/ProjectNavigation.astro';
import { getProjects } from '../../lib/projects';
export const getStaticPaths = (async () => {
  const projects = await getProjects();
  return projects.map((project, index) => ({
    params: { id: project.id },
    props: {
      project,
      previous: projects[index - 1],
      next: projects[index + 1],
    },
  }));
}) satisfies GetStaticPaths;
type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { project, previous, next } = Astro.props;
const { Content, headings } = await render(project);
---

<BaseLayout title={project.data.title} description={project.data.summary}>
  <article class="case-study editorial-page wrap">
    <a class="back-link" href="/projects/">
      ← All projects
    </a>
    <ProjectHeader project={project} />
    <ProjectFigure {...project.data.poster} />
    <div class="case-reading-layout">
      <aside>
        <TableOfContents headings={headings} />
      </aside>
      <div class="case-content">
        {project.data.editorialStatus === 'draft' && (
          <p class="editorial-note">
            Working case study · Methods and contributions are outlined here.
            Quantitative results and experimental figures are reserved for a
            later review.
          </p>
        )}
        <MethodDiagram steps={project.data.workflow} />
        <Prose>
          <Content />
        </Prose>
        <ProjectResources links={project.data.links} />
      </div>
    </div>
    <ProjectNavigation previous={previous} next={next} />
  </article>
</BaseLayout>
<style>
  .case-reading-layout {
    display: grid;
    grid-template-columns: 13.5rem minmax(0, 1fr);
    gap: clamp(2.5rem, 5vw, 5rem);
    border-top: 1px solid var(--color-line);
    margin-top: 2.75rem;
    padding-top: 2.5rem;
  }
  .case-reading-layout aside {
    min-width: 0;
  }
  .case-content {
    min-width: 0;
  }
  .case-content > .editorial-note {
    margin: 0 0 2.5rem;
    max-width: 78ch;
  }
  @media (max-width: 900px) {
    .case-reading-layout {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }
</style>
