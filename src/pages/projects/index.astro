---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectsShowcase from '../../components/ProjectsShowcase.astro';
import PortfolioScene from '../../components/PortfolioScene.astro';
import ProjectPreview from '../../components/ProjectPreview.astro';
import { getProjects, toSceneProject } from '../../lib/projects';
const projects = await getProjects();
---

<BaseLayout
  title="Projects"
  description="Explore seven projects in quantitative finance, machine learning and data science."
  works
>
  <PortfolioScene projects={projects.map(toSceneProject)} mode="index" />
  <ProjectsShowcase projects={projects} mode="index" />
  <ProjectPreview />
</BaseLayout>
