---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectList from '../../components/ProjectList.astro';
import { getProjects } from '../../lib/projects';
const projects = await getProjects();
---

<BaseLayout
  title="Projects"
  description="Explore seven projects in quantitative finance, machine learning and data science."
>
  <div class="editorial-page wrap">
    <header class="page-heading">
      <p class="eyebrow">01 / The project index</p>
      <h1>
        Ideas into
        <br />
        <em>practice.</em>
      </h1>
      <p class="lead">
        From financial trajectories to recommendation systems. Seven
        explorations in applied research and engineering.
      </p>
    </header>
    <section aria-label="All projects">
      <ProjectList projects={projects} />
    </section>
  </div>
</BaseLayout>
