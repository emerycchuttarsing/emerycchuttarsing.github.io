---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectList from '../../components/ProjectList.astro';
import { getProjects } from '../../lib/projects';
const projects = await getProjects();
---

<BaseLayout
  title="Projects"
  description="Explore seven projects in quantitative finance, machine learning and data science."
>
  <div class="page-heading">
    <p class="eyebrow">Research & engineering</p>
    <h1>Projects</h1>
    <p class="lead">
      From financial trajectories to recommendation systems: a collection of
      applied research and engineering work.
    </p>
  </div>
  <section aria-labelledby="all-projects-title">
    <h2 id="all-projects-title" class="visually-hidden">
      All projects
    </h2>
    <ProjectList projects={projects} />
  </section>
</BaseLayout>
