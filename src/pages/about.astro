---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProfileLinks from '../components/ProfileLinks.astro';
import ProfileTimeline from '../components/ProfileTimeline.astro';
import SkillGroups from '../components/SkillGroups.astro';
import { site } from '../data/site';
---

<BaseLayout
  title="About"
  description={`About ${site.name}: quantitative finance, machine learning and engineering.`}
>
  <article class="editorial-page wrap">
    <div class="about-layout">
      <div>
        <p class="eyebrow">02 / The person behind the models</p>
        <h1>
          A curious mind.
          <br />
          <em>A rigorous approach.</em>
        </h1>
        <p class="lead">{site.biography}</p>
        <ProfileLinks />
      </div>
      <div class="about-diagram" aria-hidden="true">
        <svg viewBox="0 0 480 480" fill="none">
          <circle
            cx="240"
            cy="240"
            r="172"
            stroke="#8e9690"
            stroke-width=".6"
          />
          <circle
            cx="240"
            cy="240"
            r="119"
            stroke="#8e9690"
            stroke-width=".6"
          />
          <circle cx="240" cy="240" r="68" stroke="#8e9690" stroke-width=".6" />
          <ellipse
            cx="240"
            cy="240"
            rx="172"
            ry="55"
            stroke="#785b32"
            stroke-width=".8"
            transform="rotate(-38 240 240)"
          />
          <ellipse
            cx="240"
            cy="240"
            rx="172"
            ry="55"
            stroke="#617d84"
            stroke-width=".8"
            transform="rotate(38 240 240)"
          />
          <path
            d="M240 28V452M28 240H452"
            stroke="#8e9690"
            stroke-width=".6"
            stroke-dasharray="2 7"
          />
          <circle cx="240" cy="240" r="5" fill="#785b32" />
          <circle cx="375" cy="135" r="4" fill="#617d84" />
          <circle cx="134" cy="330" r="4" fill="#785b32" />
        </svg>
        <p class="eyebrow">Finance × Mathematics × Engineering</p>
      </div>
    </div>
    <section class="profile-section" aria-labelledby="approach-title">
      <div class="profile-section-heading">
        <p class="eyebrow">01 / Perspective</p>
        <h2 id="approach-title">How I work.</h2>
      </div>
      <div class="profile-copy">
        {site.approach.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
        <a class="text-link" href="/projects/">
          Explore the projects <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>
    <section class="profile-section" aria-labelledby="experience-title">
      <div class="profile-section-heading">
        <p class="eyebrow">02 / In practice</p>
        <h2 id="experience-title">Experience.</h2>
      </div>
      <ProfileTimeline entries={site.experience} />
    </section>
    <section class="profile-section" aria-labelledby="education-title">
      <div class="profile-section-heading">
        <p class="eyebrow">03 / Foundations</p>
        <h2 id="education-title">Education.</h2>
      </div>
      <ProfileTimeline entries={site.education} />
    </section>
    <section class="profile-section" aria-labelledby="skills-title">
      <div class="profile-section-heading">
        <p class="eyebrow">04 / Toolkit</p>
        <h2 id="skills-title">Skills.</h2>
      </div>
      <SkillGroups groups={site.skillGroups} />
    </section>
    <section class="contact-section" aria-labelledby="contact-title">
      <p class="eyebrow">05 / Contact</p>
      <h2 id="contact-title">{site.contact.heading}</h2>
      <p>{site.contact.description}</p>
      {site.links.email && (
        <a class="contact-email" href={`mailto:${site.links.email}`}>
          {site.links.email}
          <span aria-hidden="true">↗</span>
        </a>
      )}
      <ProfileLinks label="Contact and CV" />
    </section>
  </article>
</BaseLayout>
<style>
  .profile-section {
    display: grid;
    grid-template-columns: 14rem minmax(0, 1fr);
    gap: 4rem;
    margin-block: 4rem 5rem;
  }
  .profile-section-heading {
    padding-top: 0.5rem;
  }
  .profile-section-heading h2 {
    font-size: 2.5rem;
    margin: 0.75rem 0 0;
  }
  .profile-section-heading .eyebrow {
    margin-bottom: 0;
  }
  .profile-copy {
    max-width: 70ch;
    color: var(--color-muted);
    padding-top: 0.5rem;
  }
  .profile-copy .text-link {
    color: var(--color-ink);
    margin-top: 0.5rem;
  }
  .contact-section {
    border-top: 1px solid var(--color-line);
    padding-top: 3rem;
    margin-top: 5rem;
  }
  .contact-section h2 {
    margin-block: 1rem 1.5rem;
  }
  .contact-section > p:not(.eyebrow) {
    max-width: 62ch;
    color: var(--color-muted);
  }
  .contact-email {
    display: inline-flex;
    align-items: center;
    gap: 1.25rem;
    text-decoration: none;
    font: clamp(1.15rem, 2.5vw, 2rem) var(--font-display);
    padding-block: 1rem;
    overflow-wrap: anywhere;
  }
  .contact-email span {
    flex-shrink: 0;
    font-family: var(--font-body);
    font-size: 1.15rem;
  }
  .contact-email:hover {
    text-decoration: underline;
  }
  @media (max-width: 900px) {
    .profile-section {
      grid-template-columns: 1fr;
      gap: 1.75rem;
      margin-block: 3rem 4rem;
    }
  }
</style>
